# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/careerai?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# File Upload
MAX_FILE_UPLOAD=5000000
FILE_UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Transactional Email (SMTP - e.g. SendGrid, Postmark, AWS SES, Gmail SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_smtp_password_or_api_key
EMAIL_FROM_NAME=CareerAI
EMAIL_FROM_ADDRESS=notifications@careerai.com
